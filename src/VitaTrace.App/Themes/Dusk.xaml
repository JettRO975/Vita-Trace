<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 暮紫配色：大面积背景由 #945FFA → #F698B8 → #F7DFD9 融合而成，
         边框/分隔线沿用同一组颜色；卡片使用半透明白，让背景颜色能透出来。 -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D8C4FF" Offset="0" />
        <GradientStop Color="#F8C9DD" Offset="0.55" />
        <GradientStop Color="#F7E2D8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF7FF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFE2FF" />
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAD9FF" Offset="0" />
        <GradientStop Color="#FBD7E4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F2E3FF" />
    <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B79AF4" Offset="0" />
        <GradientStop Color="#F3ABC4" Offset="0.55" />
        <GradientStop Color="#E8B9A9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A1738" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D476F" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8D7A9C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#945FFA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7E48E6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EADFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#F698B8" />
    <SolidColorBrush x:Key="AccentTertiaryBrush" Color="#F7DFD9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0E8F62" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9C6100" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D33138" />
    <SolidColorBrush x:Key="RingTrackBrush" Color="#E6D8F5" />
    <SolidColorBrush x:Key="BannerWarningBackgroundBrush" Color="#FFF4D9" />
    <SolidColorBrush x:Key="BannerWarningBorderBrush" Color="#E9C77C" />
    <SolidColorBrush x:Key="BannerInfoBackgroundBrush" Color="#F5E8FF" />
    <SolidColorBrush x:Key="BannerInfoBorderBrush" Color="#D6B8F5" />
    <Color x:Key="WindowShadowColor">#33000000</Color>
    <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7D4BE0" Offset="0" />
        <GradientStop Color="#C96FAF" Offset="0.58" />
        <GradientStop Color="#F2B9C9" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
