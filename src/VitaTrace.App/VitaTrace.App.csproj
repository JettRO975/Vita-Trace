<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘已改用原生 Shell_NotifyIcon，不再需要 WinForms 运行时。 -->
    <UseSystemDrawing>true</UseSystemDrawing>
    <!-- 关闭 SDK 隐式 using：WinForms 与 WPF 有大量同名类型（Application/Brush/Color），
         统一在 GlobalUsings.cs 里显式声明，避免歧义。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VitaTrace.App</RootNamespace>
    <AssemblyName>VitaTrace</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\VitaTrace.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- WFO0003：WinForms 分析器要求把 DPI 配置移到代码里。本项目是 WPF 应用，
         只是借用 NotifyIcon；PerMonitorV2 仍应由 app.manifest 声明，保留并抑制该警告。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 桌面小工具不需要后台并发 GC；关闭并发 GC 可减少一个 GC 线程和后台堆，
         对常驻内存更友好。 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- 同时作为窗口图标（pack URI）与 exe 图标（ApplicationIcon）。 -->
    <Resource Include="Assets\VitaTrace.ico" />
    <Resource Include="Assets\VitaTrace-Logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VitaTrace.Core\VitaTrace.Core.csproj" />
    <ProjectReference Include="..\VitaTrace.Infrastructure\VitaTrace.Infrastructure.csproj" />
  </ItemGroup>
</Project>
