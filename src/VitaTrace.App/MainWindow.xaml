<Window x:Class="VitaTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitaTrace.App.Controls"
        xmlns:views="clr-namespace:VitaTrace.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppName}"
        Icon="pack://application:,,,/Assets/VitaTrace.ico"
        Width="1180" Height="760" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 自绘标题栏：保留系统拖动、缩放和 Win11 贴边布局，但按钮由应用绘制。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 右侧标题下的类型/连接/状态小标签 -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="DeviceNumberBadge" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏：设置/最小化/关闭，无全屏按钮 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradientBrush}">
            <Grid Margin="18,0,10,0">
                <StackPanel x:Name="BrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="12" Background="#33FFFFFF">
                        <TextBlock Text="V" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource AppName}" Margin="10,0,0,0"
                               Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Tagline}" Margin="10,0,0,0"
                               Foreground="#D9FFFFFF"
                               FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Click="Minimize_Click"
                            Style="{StaticResource HeaderButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource Minimize}"
                            AutomationProperties.Name="{DynamicResource Minimize}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,8 H15" />
                    </Button>

                    <Button x:Name="CloseButton" Click="Close_Click"
                            Style="{StaticResource HeaderCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource Close}"
                            AutomationProperties.Name="{DynamicResource Close}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,3 L15,15 M15,3 L3,15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主内容：左侧导航 + 右侧页面 ===== -->
        <Grid Grid.Row="1" Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧主导航：设备 / 设置 / 关于，设置不再弹出独立窗口 -->
            <Border Grid.Column="0" CornerRadius="12" Padding="10,12,10,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavItemStyle}"
                                 GroupName="MainNav" Tag="Devices" IsChecked="True"
                                 Checked="Nav_Checked"
                                 AutomationProperties.Name="{DynamicResource Devices}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Devices}" FontSize="13"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" MinWidth="22" Height="22" CornerRadius="12"
                                    Background="{DynamicResource AccentBrush}" Padding="6,0"
                                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DeviceBadgeText}" Foreground="White"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Grid.Row="1" Style="{StaticResource NavItemStyle}"
                                 GroupName="MainNav" Tag="Settings"
                                 Checked="Nav_Checked"
                                 AutomationProperties.Name="{DynamicResource Settings}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Data="M4,7 H20 M4,12 H20 M4,17 H20 M8,5 V9 M15,10 V14 M8,15 V19" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings}" FontSize="13"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" Grid.Row="2" Style="{StaticResource NavItemStyle}"
                                 GroupName="MainNav" Tag="About"
                                 Checked="Nav_Checked"
                                 AutomationProperties.Name="{DynamicResource About}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,10 V17 M12,7 V7.2" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource About}" FontSize="13"
                                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页面标题：设备 / 设置 / 关于共用 -->
                <StackPanel Grid.Row="0" Margin="2,0,0,10">
                    <TextBlock x:Name="PageTitle" Text="{DynamicResource DevicesPageTitle}"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="{DynamicResource DevicesPageSubtitle}"
                               Style="{StaticResource SubtleTextStyle}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- 设备页：横幅 + 原来的列表/详情两栏 -->
                <Grid x:Name="DevicesPage" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 演示/低电量横幅：放在两栏上方，避免挤压右侧详情布局 -->
                    <StackPanel x:Name="BannerHost" Grid.Row="0">
                <Border Background="{DynamicResource BannerWarningBackgroundBrush}"
                        BorderBrush="{DynamicResource BannerWarningBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding HasLowBattery, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LowBatteryText}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BannerInfoBackgroundBrush}"
                        BorderBrush="{DynamicResource BannerInfoBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="12"
                                Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DemoBadge}" Foreground="White"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{DynamicResource DemoTitle}" FontSize="12" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource DemoHint}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：设备列表 -->
                <Border x:Name="DevicePanel" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid Margin="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Devices}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DeviceCountText}" Style="{StaticResource TinyTextStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="30" Height="30" Padding="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Tag="Refresh"
                                    ToolTip="{DynamicResource RefreshTooltip}">
                                <Path Width="15" Height="15" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     SelectionChanged="Devices_SelectionChanged"
                                     ItemContainerStyle="{StaticResource DeviceListItemStyle}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource DeviceNumberBadge}">
                                                    <TextBlock Text="{Binding NumberText}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BatteryText}" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"
                                                           Foreground="{Binding RingBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 无设备状态：叠在列表区域中央，不伪造任何设备卡 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18"
                                        Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVis}}">
                                <Path Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.1"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3,3 H21 V17 H3 Z M8,21 H16 M12,17 V21" />
                                <TextBlock Text="{DynamicResource NoDevices}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="{DynamicResource NoDevicesHint}" Style="{StaticResource TinyTextStyle}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="12" Padding="10,7" Margin="0,10,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TinyTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 右：选中设备详情 -->
                <Grid x:Name="DetailPanel" Grid.Column="2">
                    <!-- 隐藏竖向滚动条，但保留鼠标滚轮/触摸滚动；避免右侧出现一条常驻竖条。 -->
                    <ScrollViewer x:Name="DetailScroll"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  FocusVisualStyle="{x:Null}">
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 设备标题；铅笔进入内联重命名，Enter 保存、Esc 取消 -->
                            <Grid Grid.Row="0" Margin="4,2,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid MinHeight="42">
                                        <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="24" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBox x:Name="RenameTextBox"
                                                 Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 FontSize="20" MinHeight="42" Padding="8,6"
                                                 VerticalContentAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                 KeyDown="RenameTextBox_KeyDown"
                                                 ToolTip="{DynamicResource RenameHint}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource ChipBorder}">
                                        <TextBlock Text="{Binding SelectedDevice.KindText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipBorder}">
                                        <TextBlock Text="{Binding SelectedDevice.ConnectionText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource ChipBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding SelectedDevice.StatusBrush}"
                                                     Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedDevice.StatusText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="RenameButton" Width="30" Height="30"
                                        Margin="8,0,0,0" VerticalAlignment="Top" Padding="0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="Rename_Click"
                                        ToolTip="{DynamicResource RenameDevice}"
                                        AutomationProperties.Name="{DynamicResource RenameDevice}">
                                    <Grid Width="15" Height="15">
                                        <Path Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"
                                              Data="M4,20 L5,15 L16,4 L20,8 L9,19 Z M14,6 L18,10" />
                                        <Path Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                              Data="M3,8 L6,11 L13,4" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 电量圆环 + 历史曲线 -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                <Grid Margin="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:BatteryRing Width="230" Height="230"
                                                          Percent="{Binding SelectedDevice.PercentValue}"
                                                          Text="{Binding SelectedDevice.RingText}"
                                                          Caption="{Binding SelectedDevice.RingCaption}"
                                                          ProgressBrush="{Binding SelectedDevice.RingBrush}"
                                                          TrackBrush="{DynamicResource RingTrackBrush}"
                                                          TextBrush="{DynamicResource TextPrimaryBrush}"
                                                          CaptionBrush="{DynamicResource TextTertiaryBrush}"
                                                          Thickness="16"
                                                          VerticalAlignment="Center" />

                                    <Grid Grid.Column="1" Margin="26,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <TextBlock Text="{DynamicResource History}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedDevice.HistoryRangeText}"
                                                       Style="{StaticResource TinyTextStyle}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,0" MinHeight="170">
                                            <controls:Sparkline Points="{Binding SelectedDevice.History}"
                                                                Stroke="{Binding SelectedDevice.RingBrush}"
                                                                GridBrush="{DynamicResource BorderBrush}"
                                                                TextBrush="{DynamicResource TextTertiaryBrush}"
                                                                Height="170" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding SelectedDevice.HasHistory, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{DynamicResource NoHistory}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource HistoryHint}" Style="{StaticResource TinyTextStyle}"
                                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                                <TextBlock Text="{DynamicResource Source}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding SelectedDevice.SourceText}" Style="{StaticResource MetaValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                <TextBlock Text="{DynamicResource Confidence}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding SelectedDevice.ConfidenceText}" Style="{StaticResource MetaValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding SelectedDevice.UpdatedText}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding SelectedDevice.Subtitle}" Style="{StaticResource MetaValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="{DynamicResource Receiver}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding SelectedDevice.ReceiverText}" Style="{StaticResource MetaValue}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Text="{Binding SelectedDevice.HintText}"
                                                   Style="{StaticResource TinyTextStyle}" TextWrapping="Wrap"
                                                   Margin="0,12,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 设备详情 -->
                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <StackPanel Margin="20,18">
                                    <TextBlock Text="{DynamicResource Detail}" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                            <TextBlock Text="{DynamicResource Model}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.ModelText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="{DynamicResource Vendor}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.VendorText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12">
                                            <TextBlock Text="{DynamicResource VidPid}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.VidPidText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="{DynamicResource Connection}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.ConnectionText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,12">
                                            <TextBlock Text="{DynamicResource Receiver}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.ReceiverText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="{DynamicResource Status}" Style="{StaticResource MetaLabel}" />
                                            <TextBlock Text="{Binding SelectedDevice.StatusText}" Style="{StaticResource MetaValue}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- 有设备但未选中 / 无设备 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,3 H21 V17 H3 Z M8,21 H16 M12,17 V21" />
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource SubtleTextStyle}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

            <!-- 设置直接嵌在右侧页面里，不再弹独立窗口 -->
            <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />

            <!-- 关于页 -->
            <ScrollViewer x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardBorderStyle}" Padding="30,28" Margin="0,0,4,4">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <Border Width="54" Height="54" CornerRadius="12" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="V" Foreground="White" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="{DynamicResource AppVersion}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource TinyTextStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource AboutDescription}" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="22" Margin="0,18,0,0" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12"
                                Padding="14,12" Margin="0,20,0,0">
                            <TextBlock Text="{DynamicResource AboutPrivacy}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="20" />
                        </Border>
                        <TextBlock Text="{DynamicResource FooterPhase}" Style="{StaticResource TinyTextStyle}"
                                   TextWrapping="Wrap" Margin="2,14,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Grid>
</Window>
