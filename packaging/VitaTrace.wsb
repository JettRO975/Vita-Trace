<Configuration>
  <!-- Vita Trace smoke test in Windows Sandbox. Adjust HostFolder if the repo moves. -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>E:\Vita Trace\dist\VitaTrace-1.0.0-win-x64</HostFolder>
      <SandboxFolder>C:\VitaTrace</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>E:\Vita Trace\tests\acceptance</HostFolder>
      <SandboxFolder>C:\VitaTraceTests</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "" "C:\VitaTrace\VitaTrace.exe" --demo</Command>
  </LogonCommand>
</Configuration>
